@article{StemmWolf2026-ro,
 abstract = {Cell-size control is necessary for the optimum function and fitness of
cells. In many eukaryotes, cell size is controlled through the initiation
of cell division once a size threshold is achieved. Cells sense their size
through the relationship of cell-size-dependent and independent factors,
though the mechanistic details are known for few eukaryotes. An additional
dimension of cell-size control is the subcellular localization and control
of cell-cycle regulators. The cell cortex is a known site of cell-cycle
regulator accumulation that maintains an established cell size based on
surface area. Once cells commit to division, cyclins and their associated
cyclin-dependent kinases (CDKs) coordinate DNA synthesis, mitosis, and
cell division. Cyclin/CDK activity is regulated by multiple mechanisms,
including by non-coding RNAs and RNA-binding proteins. Centrosomes are
also activation sites of cyclin/CDKs and other cell-cycle regulators. The
cortex of the ciliate Tetrahymena thermophila is distinguished by ciliary
rows comprised of basal bodies (BBs), which are similar to the centrioles
within centrosomes and the site of Tetrahymena CDK localization. The
number of BBs per Tetrahymena cell remains consistent for each cell-cycle
stage, even as the number and lengths of ciliary rows vary, indicating
that the BB number is more regulated than cell volume. Utilizing the
large-cell Tetrahymena big1-1 mutant strain, we identify Big1 to be an
RNA-binding domain (RBD)-containing protein that localizes to BBs and
controls cell size through its influence on cell-cycle progression,
suggesting that BBs are a size-dependent measure of cell growth.},
 author = {Stemm-Wolf, Alexander J and Soh, Adam W J and Mitchell, Lisa E and Sun,
Huangqingbo and Collet, Erik and Dholakia, Gayatri L and Raju, Vikram and
Hesselberth, Jay R and Taliaferro, J Matthew and Murphy, Robert F and
Heasley, Lydia R and Pearson, Chad G},
 date = {2026-03-23},
 doi = {10.1016/j.cub.2026.02.065},
 issn = {1879-0445},
 journal = {Curr. Biol.},
 language = {en},
 month = {March},
 number = {7},
 pages = {1882--1891.e4},
 pmc = {PMC13014017},
 pmid = {41875877},
 title = {Big1 is a cell-cycle regulator linking cell size to basal body number in
Tetrahymena thermophila},
 volume = {36},
 year = {2026}
}
