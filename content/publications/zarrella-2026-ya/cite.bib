@article{Zarrella2026-ya,
 abstract = {Arthritogenic alphaviruses, including chikungunya virus (CHIKV), Mayaro
virus and Ross River virus, cause long-lasting musculoskeletal pain and
inflammation. However, the mechanisms driving chronic disease remain
unclear. Here, we used single-cell RNA sequencing, spatial transcriptomics
and flow cytometry to investigate joint-associated tissues in
alphavirus-infected mice at a late stage of infection. We identified an
accumulation of inflammatory macrophages in joint-associated tissues with
elevated expression of inflammatory markers. These cells harbour CHIKV
RNA, suggesting ongoing viral replication during chronic disease. We also
identified an accumulation of CD4+ T cells in these tissues expressing
Ifng, and found that depletion of CD4+ T cells diminished major
histocompatibility complex class II expression on joint macrophages,
highlighting their potential role in inflammation. Treatment with a small
molecule inhibitor of CHIKV replication during chronic disease reduced
viral RNA and joint inflammation. Our data suggest that macrophages
harbour replicating viral RNA and contribute to the sustained joint
inflammation associated with chronic alphavirus disease.},
 author = {Zarrella, Kristen M and Sheridan, Ryan M and Ware, Brian C and Davenport,
Bennett J and da Silva, Mariana O L and Vyshenska, Dariia and Martin,
Aspen U and May, Nick A and Fish, Erin R and Weiskopf, Daniela and
Hesselberth, Jay R and Streblow, Daniel N and Greninger, Alex L and
Morrison, Thomas E},
 date = {2026-04-01},
 doi = {10.1038/s41564-026-02303-9},
 issn = {2058-5276},
 journal = {Nat. Microbiol.},
 language = {en},
 month = {April},
 number = {5},
 pages = {1302--1317},
 pmc = {PMC13171603},
 pmid = {41922840},
 preview = {zarella-chikv.png},
 title = {Chikungunya virus persists in joint-associated macrophages and promotes
chronic disease in mice},
 volume = {11},
 year = {2026}
}
