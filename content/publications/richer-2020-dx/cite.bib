@article{Richer2020-dx,
 abstract = {Methods to measure heterogeneity among cells are rapidly
transforming our understanding of biology but are currently
limited to molecular abundance measurements. We developed an
approach to simultaneously measure biochemical activities and
mRNA abundance in single cells to understand the heterogeneity
of DNA repair activities across thousands of human lymphocytes,
identifying known and novel cell-type-specific DNA repair
phenotypes.},
 author = {Richer, Amanda L and Riemondy, Kent A and Hardie, Lakotah and
Hesselberth, Jay R},
 doi = {10.1093/nar/gkaa240},
 github = {https://github.com/hesselberthlab/sc-haircut},
 issn = {0305-1048, 1362-4962},
 journal = {Nucleic Acids Res.},
 language = {en},
 month = {June},
 number = {10},
 pages = {e59},
 pmc = {PMC7261187},
 pmid = {32286626},
 preview = {richer-umap.jpg},
 publisher = {Oxford University Press},
 title = {Simultaneous measurement of biochemical phenotypes and gene
expression in single cells},
 volume = {48},
 year = {2020}
}
